# IntelliStock - root .gitignore

# Node.js dependencies
node_modules/
**/node_modules/

# Python virtual environments
venv/
**/venv/
.venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]

# Environment variables and secrets
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Logs and temporary files
logs/
**/logs/
*.log
npm-debug.log*

# Build output
dist/
build/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# IntelliStock temporary server files
server/cookies
server/tmp-*
